{
  "editor.acceptSuggestionOnCommitCharacter": false,
  "editor.acceptSuggestionOnEnter": "smart",
  "editor.accessibilityPageSize": 12,
  "editor.accessibilitySupport": "off",
  "editor.fontFamily": "Iosevka Curly",
  "editor.fontLigatures": true,
  "editor.fontSize": 14,
  "editor.guides.bracketPairs": true,
  "editor.inlineSuggest.edits.allowCodeShifting": "never",
  "editor.inlineSuggest.fontFamily": "Comic Sans MS",
  "editor.inlineSuggest.syntaxHighlightingEnabled": false,
  "editor.mouseWheelZoom": true,
  "editor.quickSuggestionsDelay": 200,
  "editor.renderWhitespace": "trailing",
  "editor.rulers": [80, 100],
  "editor.screenReaderAnnounceInlineSuggestion": false,
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "explorer.openEditors.sortOrder": "alphabetical",
  "extensions.ignoreRecommendations": true,
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 5000,
  "git.alwaysShowStagedChangesResourceGroup": true,
  "git.blame.editorDecoration.enabled": false,
  "git.blame.statusBarItem.enabled": true,
  "git.blame.statusBarItem.template": "${authorDateAgo}, ${authorName}: ${subject}",
  "git.confirmSync": false,
  "git.ignoreMissingGitWarning": true,
  "git.openRepositoryInParentFolders": "always",
  "git.suggestSmartCommit": false,
  "github.copilot.renameSuggestions.triggerAutomatically": false,
  "json.schemaDownload.enable": true,
  "keyboard.touchbar.enabled": false,
  "python.analysis.autoSearchPaths": false,
  "python.analysis.extraPaths": [],
  "python.autoComplete.extraPaths": [],
  "python.terminal.activateEnvironment": false,
  "remote.autoForwardPortsSource": "hybrid",
  "screencastMode.fontSize": 42,
  "screencastMode.keyboardOverlayTimeout": 500,
  "screencastMode.mouseIndicatorSize": 40,
  "screencastMode.verticalOffset": 10,
  "telemetry.telemetryLevel": "off",
  "terminal.integrated.enablePersistentSessions": false,
  "terminal.integrated.fontFamily": "MesloLGS NF",
  "terminal.integrated.persistentSessionReviveProcess": "never",
  "terminal.integrated.persistentSessionScrollback": 20000,
  "terminal.integrated.scrollback": 20000,
  "window.autoDetectColorScheme": true,
  "window.autoDetectHighContrast": false,
  "workbench.colorCustomizations": {
    "[GitHub Dark Default]": {
      "editor.selectionBackground": "#94079b",
      "editor.selectionForeground": "#ff00e6",
      "editor.selectionHighlightBorder": "#ff00f7",
      "editor.wordHighlightBackground": "#023f0e90",
      "editor.wordHighlightBorder": "#07fb38",
      "editor.wordHighlightStrongBackground": "#39370190",
      "editor.wordHighlightStrongBorder": "#ffff00",
      "editorLineNumber.activeForeground": "#13f7ff",
      "editorLineNumber.foreground": "#186792",
      "editorRuler.foreground": "#232323"
    },
    "[GitHub Light Default]": {
      "editor.selectionBackground": "#a9fbf7",
      "editor.selectionForeground": "#00dac4",
      "editor.selectionHighlightBorder": "#006b6a",
      "editor.wordHighlightBackground": "#caffd190",
      "editor.wordHighlightBorder": "#11b20f",
      "editor.wordHighlightStrongBackground": "#fcfc5990",
      "editor.wordHighlightStrongBorder": "#ffaa00",
      "editorGhostText.background": "#e8e8e8",
      "editorGhostText.border": "#e3e3e3",
      "editorGhostText.foreground": "#ffffff",
      "editorLineNumber.activeForeground": "#000000",
      "editorLineNumber.foreground": "#97bbce",
      "editorRuler.foreground": "#d0d0d0"
    }
  },
  "workbench.colorTheme": "GitHub Dark Default",
  "workbench.editor.enablePreview": false,
  "workbench.editor.showTabs": "single",
  "workbench.editor.tabActionLocation": "left",
  "workbench.editorAssociations": {
    "*.ipynb": "jupyter-notebook"
  },
  "workbench.preferredDarkColorTheme": "GitHub Dark Default",
  "workbench.preferredLightColorTheme": "GitHub Light Default",
  "workbench.sideBar.location": "right",
  "workbench.startupEditor": "none",
  "workbench.tree.indent": 20,
  "workbench.tree.renderIndentGuides": "always",
  "zenMode.hideLineNumbers": false,
  "docker.extension.dockerEngineAvailabilityPrompt": false,
  "svelte.ask-to-enable-ts-plugin": false,
  "makefile.configureOnOpen": false,
  "editor.inlineSuggest.enabled": false,
  "github.copilot.enable": {
    "*": false
  },
  "chat.viewSessions.orientation": "stacked",
  "[python]": {
    
    "diffEditor.ignoreTrimWhitespace": false,
    "editor.defaultColorDecorators": "never"
  },
  "editor.codeActionsOnSave": {
    
  },
}